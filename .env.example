# These are set in the Netlify dashboard (Site settings -> Environment variables),
# NOT committed. Each Netlify site gets its own values.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only

# --- football-data.org (one token per site is fine) ---
FOOTBALL_DATA_TOKEN=your-football-data-token

# --- Site branding (injected at build into config.js + index.html) ---
SITE_GROUP_NAME=استراحة 6
SITE_TAGLINE=توقّعات لاستراحة 6. بطلٌ واحد. وافتخارٌ طوال الصيف.
SITE_BOARD_EMPTY=🏆 يظهر الترتيب عند انطلاق كأس العالم. سجّلوا استراحة 6 وابدؤوا التوقّع!
